# Supabase project (Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Supabase database (Settings > Database > Connection string > URI, "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Only these emails can use the app (comma separated)
ALLOWED_EMAILS=you@gmail.com
# Your GitHub Pages origin (no trailing slash and no path), e.g. https://username.github.io
CORS_ORIGINS=https://username.github.io,http://localhost:5173
